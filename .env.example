# =====================================================================
#  Container Image Hosting — TEMPLATE konfigurasi
#  JANGAN commit file .env yang berisi nilai asli!
#  1. Salin file ini menjadi `.env`  (cp .env.example .env)
#  2. Isi nilai aslinya.
#  3. Semua variabel di bawah ini juga bisa di-set langsung sebagai
#     Environment Variables di Railway (Service > Variables).
# =====================================================================

# ---------- Dropbox (storage) ----------
# App key & App secret dari https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here

# Refresh token (long-lived) — WAJIB untuk sinkronisasi Dropbox.
# Cara membuat: jalankan `rclone authorize "dropbox" "<APP_KEY>" "<APP_SECRET>"`
# lalu tempel SELURUH blok JSON yang dicetak ke variabel ini.
DROPBOX_REFRESH_TOKEN='{"access_token":"...","token_type":"bearer","refresh_token":"...","expiry":"..."}'

# (Opsional) Short-lived access token (berawalan "sl." — hanya ±4 jam).
# Hanya dipakai oleh skrip pengecekan (check_dropbox.sh), BUKAN untuk sync.
DROPBOX_ACCESS_TOKEN=

# Folder tujuan di Dropbox (relatif terhadap App folder / root).
DROPBOX_PATH=container-images

# ---------- Registry ----------
# Alamat internal registry (biasanya tidak perlu diubah).
REGISTRY_HTTP_ADDR=:5000
# Direktori penyimpanan lokal di dalam container.
REGISTRY_STORAGE_DIR=/data

# ---------- Keamanan (opsional — SANGAT disarankan) ----------
# Jika diisi, endpoint registry akan meminta Basic Auth via nginx.
REGISTRY_AUTH_USER=
REGISTRY_AUTH_PASS=

# ---------- Sinkronisasi ----------
# Interval backup /data -> Dropbox (detik). Default 300 (5 menit).
SYNC_INTERVAL_SECONDS=300
